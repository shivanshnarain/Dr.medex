# Vercel Deployment Optimization Ignore File
# Excludes non-runtime files from Deployment Storage and Functions Storage bundles

# Backups and historical dumps
server/data/backups
server/data/*.backup*
*.backup*
client/server/data/backups

# Large non-runtime scraper dumps & audit reports
server/data/physiotherapy_scraped_products.json
server/data/extracted_products.json
server/data/price_sync_report.json
server/data/reference_catalogue_audit.json
server/data/physio_category_audit.json
server/data/crawled_urls.json
server/services/*.py
client/server/data/physiotherapy_scraped_products.json
client/server/data/extracted_products.json
client/server/data/price_sync_report.json
client/server/data/reference_catalogue_audit.json
client/server/data/physio_category_audit.json
client/server/data/crawled_urls.json
client/server/services/*.py

# Test suites and development artifacts
server/tests
client/server/tests
test_suite.js
*.test.js
*.spec.js

# Internal scripts and services not invoked in production
scripts
laravel-storage-service
*.md

# Git and OS metadata
.git
.github
.DS_Store
*.log
